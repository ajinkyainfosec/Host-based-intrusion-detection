# .env.example
# Sentinel HIDS — Environment Variables Template
# Copy to .env and fill in values before running docker-compose
# NEVER commit .env to version control

# ── Database ─────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── Elasticsearch ────────────────────────────────────────────────
ELASTIC_PASSWORD=CHANGE_ME_elastic_password_here

# ── Server Security ──────────────────────────────────────────────
# Agent authentication key (32+ chars, random)
API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# JWT signing secret (64+ chars, random)
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64

# ── Server Config ────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTINEL_SERVER_URL=https://localhost
